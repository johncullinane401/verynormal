raw `CURSEZONE_MapScripts::
	.byte 0
`

script CURSEZONE_EventScript_YanFight {
	lockall
	msgbox(".......")
	msgbox("It's you...")
	msgbox("I knew you would run into me\neventually.")
	msgbox("...take a look around us.")
	msgbox("There's nothing left, except\nfor me and you.")
	msgbox("I know...I can't do anything\nto stop you.")
	msgbox("And even if I could do anything,\nwhat good what it be, right?")
	msgbox("Who would I even be saving...at that\npoint?.")
	msgbox("So, that's why I'm not here to stop you.")
	msgbox("But...")
	msgbox("I know what you really want.")
	msgbox("Because truth is...we both want the\nsame thing.")
	msgbox("I know you. And I know you\nnever liked doing things the easy way.")
	msgbox("So, how about this.")
	msgbox("One last game.")
	msgbox("If you win...do what you want.")
	msgbox("After all, I'm not opposed to it.")
	msgbox("But if I win, we do things my\nway.")
	msgbox("I won't 'join' with you.")
	msgbox("Instead...")
	msgbox("The both of us will stay here.")
	msgbox("We'll stay here until the sun explodes\nand erases us.")
	msgbox("Do you even remember...how long\nit's been?")
	msgbox("What's another eternity to us?")
	msgbox("Just me and you...it's what you've\nwanted anyway.")
	msgbox("...")
	msgbox("So...then. What will it be?")
	msgbox("Shall we do things...my way?", MSGBOX_YESNO)
	msgbox("........")
	msgbox("Oh....{PLAYER}...")
	msgbox("Sorry, I don't mean to be rude, but...")
	msgbox("I wasn't talking to you.")
	delay(100)
	msgbox("...")
	msgbox("I'm talking to...the person standing\nbehind you.")
	msgbox("...")
	msgbox("She won't say anything.")
	msgbox("...ha. I already know her answer.")
	msgbox("Since you insist on being so shy\ntoday...")
	msgbox("{PLAYER}, you'll have to do.")
	msgbox("...")
	msgbox("But before we begin, I need to know.")
	msgbox("{PLAYER}...")
	msgbox("Can you tell me...what you've\nbeen trying to accomplish?")
	msgbox("Maybe you had some guidance at the beginning, but...")
	msgbox("You've made it this far all by yourself.")
	msgbox("Have you enjoyed it?")
	msgbox("Peeling away all these memories...and dreams?")
	msgbox("But...")
	msgbox("You don't even know, do you?")
	msgbox("What you've been REALLY working towards?")
	msgbox("She hasn't told you a thing.")
	msgbox("You were never promised a reward.")
	msgbox("It'll all be over soon anyway.")
	msgbox("So in that case, I'll let you in\non a little secret,\n'{PLAYER}'")
	msgbox("From the start, you've been on her\n path.")
	msgbox("Maybe you've made some stops or\ndetours along the way, but...")
	msgbox("The path you're on was always\ndesigned to end the same way.")
	msgbox("....with me.")
	delay(50)
	msgbox("All that work...just for me. I'm\nflattered, really.")
	msgbox("But...enough of this. You came\nhereto play a game.")
	msgbox("Well, then, let's play.")
	msgbox("I can see her in the back...smiling.\nShe's been waiting for this for\pa long time.")
	msgbox("And I can't help but smile either.")

	releaseall
	trainerbattle_single(TRAINER_ALEXA, YanIntro, YanOutro)
}

text YanIntro {
	"Well, here we go, {PLAYER}. Don't you know\nit's rude to keep ladies in waiting?"
}

text YanOutro {
	"....."
}