raw  `HUB_MapScripts::
	.byte 0
`

script HUB_EventScript_MothmanTalk {
    lockall
    buffernumberstring(STR_VAR_1, VAR_VENOM)
    msgbox("I'm looking for Bug-Type Pokémon!")
    msgbox("Let's see here...")
    msgbox("You've encountered {STR_VAR_1} Bug-Type Pokémon!")
    msgbox("Whoa! Incredible!")

    if (var(VAR_VENOM) > 10) {
        msgbox("....")
        msgbox("Oh?")
        msgbox("Well...what a delicious surprise.")
        msgbox("You're quite the interesting\nfellow.")
        msgbox("Yes, yes.")
        msgbox("Finally, I can stop with that\nridiculous voice...")
        msgbox("Ah, where are my manners. You may call me\nMOTHMAN.")
        msgbox("Please, do not be alarmed. I merely\nwish to sell my services to heroes like you.")
        msgbox("I've got things you may find very\nuseful indeed.")
        msgbox("Money? No no no, no, that won't\n do at all.")
        msgbox("I have no need for material garbage\nsuch as that.")

        buffernumberstring(STR_VAR_1, VAR_VENOM)
        msgbox("You have something else I seek...")
        msgbox("Let's see...")
        msgbox("{STR_VAR_1} droplets.")
        if (var(VAR_VENOM) < 10) {
            msgbox("That's all?")
            msgbox("Bah, that's no goddamn good at all.")
            msgbox("This is hardly even an appetizer!")
            msgbox("Just forget I said anything.")
            msgbox("You don't have what I seek.")
        }
    }
    
        msgbox("Eheheh...")
        trainerbattle_single(TRAINER_JARED, MothmanIntro, MothmanOutro)
    releaseall
}

text MothmanIntro {
    "You...really got me going, kid!!"
}

text MothmanOutro {
    "...I....Impossible."
}

script HUB_EventScript_Gatekeeper {
    lockall
    msgbox("5 remain.")
    msgbox("Aren't you forgetting something?")
    releaseall
}

script HUB_EventScript_LRShortcut {
    lockall
    msgbox("", MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        clearflag(FLAG_DREAMING)
	
	    if (flag(FLAG_ROCK_PUZZLE)) {
            msgbox("The power of teleportation has\nextinguished your hand fire.")
            clearflag(FLAG_ROCK_PUZZLE)
            setvar(VAR_HOTNESS, 0)
	    }
        warp(MAP_LITTLEROOT_TOWN,42,15)
        waitstate
        
    }
    releaseall
}