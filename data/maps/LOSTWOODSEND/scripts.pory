raw `LOSTWOODSEND_MapScripts::
	.byte 0
`

script ObtainNewFriend_Lust {
    lockall
    msgbox("Greetings, {PLAYER}.")
    msgbox("You've done well to make it here.")
    msgbox("Let me join you.")
    msgbox("Together, we will take from this\nworld all that we love...")
    givemon(SPECIES_PYUKUMUKU,65)
    playfanfare(MUS_OBTAIN_ITEM)
    delay(3)
    msgbox("Asmodia joined you.")
    removeobject(1)
    setflag(GOT_ASMODIA)
    releaseall
}