PetalburgCity_Text_WhereIsWally:
	.string "Where has our WALLY gone?\p"
	.string "We have to leave for VERDANTURF TOWN\n"
	.string "very soon…$"

PetalburgCity_Text_AreYouRookieTrainer:
	.string "Hiya! Are you maybe…\n"
	.string "A rookie TRAINER?\p"
	.string "Do you know what POKéMON TRAINERS\n"
	.string "do when they reach a new town?\p"
	.string "They first check what kind of GYM\n"
	.string "is in the town.$"

PetalburgCity_Text_ThisIsPetalburgGym:
	.string "See? This is PETALBURG CITY's GYM.$"

PetalburgCity_Text_ThisIsGymSign:
	.string "This is the GYM's sign. Look for it\n"
	.string "whenever you're looking for a GYM.$"

PetalburgCity_Text_WaterReflection:
	.string "My face is reflected in the water.\p"
	.string "It's a shining grin full of hope…\p"
	.string "Or it could be a look of somber silence\n"
	.string "struggling with fear…\p"
	.string "What do you see reflected in your face?$"

PetalburgCity_Text_FullPartyExplanation:
	.string "Let's say you have six POKéMON.\n"
	.string "If you catch another one…\p"
	.string "It is automatically sent to a STORAGE\n"
	.string "BOX over a PC connection.$"

PetalburgCity_Text_GymSign:
	.string "PETALBURG CITY POKéMON GYM\n"
	.string "LEADER: NORMAN\l"
	.string "“A man in pursuit of power!”$"

PetalburgCity_Text_CitySign:
	.string "PETALBURG CITY\n"
	.string "“Where people mingle with nature.”$"

PetalburgCity_Text_WallyHouseSign:
	.string "WALLY'S HOUSE$"

PetalburgCity_Text_AreYouATrainer:
	.string "Excuse me!\p"
	.string "Let me guess, from the way you're\n"
	.string "dressed, are you a POKéMON TRAINER?$"

PetalburgCity_Text_WellMaybeNot:
	.string "… … … … … …\p"
	.string "Well, maybe not.\n"
	.string "Your clothes aren't all that dirty.\p"
	.string "You're either a rookie TRAINER,\n"
	.string "or maybe you're just an ordinary kid.$"

PetalburgCity_Text_ImLookingForTalentedTrainers:
	.string "I'm roaming the land in search of\n"
	.string "talented TRAINERS.\p"
	.string "I'm sorry to have taken your time.$"
`

script PetalburgCity_EventScript_YinTalk {
    lockall
    call(PetalburgCity_CheckForNormalType)
    faceplayer
    msgbox("I have been waiting patiently\nfor you.")
    if (flag(FLAG_YIN_SPIEL)) {
        msgbox("It is time for me to join you.")
        call(PetalburgCity_PokemonFanClub_EventScript_DDTutor)
        if (flag(FLAG_LEARNED_DD)) {
            msgbox("I do not have much time left to\nspeak with you.")
            msgbox("With your help, we can save this\nworld.")
            msgbox("Now...go....'Petalburg Woods'...")
            msgbox("....distortion...you...")
            msgbox("....must.....")
            msgbox("take it all.")
            delay(5)
            removeobject(10)
            setflag(FLAG_YIN_OLDALE)
        } else {
            msgbox("Very well. Return when you are\nready to accept my power.")
        }
    } elif (flag(FLAG_CAUGHTNORMAL)) {
        msgbox("I see you have obtain your CATALYST.")
        setflag(FLAG_DISABLE_CATCHING)
        msgbox("This is most excellent.")
        msgbox("But, to continue your path, difficult\nchoices must be made.")
        msgbox("And now, you are met with one of those\nchoices.")
        fadeoutbgm(2)
        msgbox("Your CATALSYT will prove to be very\nuseful to you.")
        msgbox("The rest of your companions...")
        msgbox("...must be discarded.")
        delay(300)
        msgbox("I know you have only known them\na short while.")
        msgbox("Are you prepared for their sacrifice?", MSGBOX_YESNO)
        if (var(VAR_RESULT) == YES) {
            delay(1000)
			fadescreen(FADE_TO_BLACK)
			delay(500)
			
			fadescreen(FADE_FROM_BLACK)
			special(DeleteAllPartyMonsExceptZigzagoon)
            msgbox("........................")
            msgbox("It has been taken care of.")
            msgbox("You are a strong-willed person.")
            msgbox("That was not an easy choice to make.")
            msgbox("Do not weep for your companions.")
            msgbox("You will see them again in the\nAshen Garden.")
			msgbox("Now...")
            setflag(FLAG_YIN_SPIEL)
            call(PetalburgCity_PokemonFanClub_EventScript_DDTutor)
            if (flag(FLAG_LEARNED_DD)) {
                msgbox("I do not have much time left to\nspeak with you.")
                msgbox("With your help, we can save this\nworld.")
                msgbox("Now...go....'Petalburg Woods'...")
                msgbox("....distortion...you...")
                msgbox("....must.....")
                msgbox("take it all.")
                delay(5)
                removeobject(10)
                setflag(FLAG_YIN_OLDALE)
            } else {
                msgbox("Very well. Return when you are\nready to accept me.")
            }
        } else {
            msgbox("Return when you are ready.")
        }
    } else {
        msgbox("Unfortunately, you have not yet\nobtained your CATALYST.")
        msgbox("Any NORMAL type will do.")
        msgbox("Please return to me once you have\nobtained one.")
    }
    releaseall
	
	special(SetExpLevel)
	setflag(FLAG_DISABLE_EXP)
}

script PetalburgCity_EventScript_ObviousRoadblock {
	lockall
	msgbox("The door is sealed tightly shut.")
	releaseall
}



script PetalburgCity_CheckForNormalType {
    checkspecies(SPECIES_ZIGZAGOON, NO_PARTY_SCREEN)
    if (var(VAR_RESULT) == TRUE) {
        setflag(FLAG_CAUGHTNORMAL)
    }
}

script PetalburgCity_EventScript_Yan1 {
    if (!flag(FLAG_FIRST_YAN_MEETING)) {
        lockall
        msgbox("{COLOR RED}Hey!")
        applymovement(11, YanMovement1)
        waitmovement(0)
        playbgm(MUS_CYCLING, FALSE)
        msgbox(YanTextTest)
        msgbox("{COLOR RED}I haven't seen you around here\nbefore. {COLOR RED}Are you new around here?", MSGBOX_YESNO)
        if (var(VAR_RESULT) == YES) {
            msgbox("{COLOR RED}I knew it!")
        } else {
            msgbox("{COLOR BLUE}Huh. Well, I've never seen you.\n{COLOR GREEN}Anyway...")
        }
        msgbox("{COLOR RED}Take this!")
        msgbox("The woman throws a small card\nat you. Catch it?", MSGBOX_YESNO) 
        if (var(VAR_RESULT) == YES) {
            msgbox("You catch the card with ease.")
        } else {
            msgbox("The card falls to your feet\non the grass.")
            msgbox("{COLOR BLUE}...oh, sorry. {COLOR GREEN}I thought\nyou'd catch it.")
            msgbox("You awkwardly pick up the card.")
        }
        giveitem(ITEM_RED_CARD, 1)
        msgbox("{COLOR GREEN}My name's Yan. I may not\nlook like it, but I'm a detective.")
        msgbox("{COLOR BLUE}...or, somethin' like that.")
        msgbox("{COLOR GREEN}Since you're new around here,\nI assume you've never heard of me?", MSGBOX_YESNO)
        msgbox("{COLOR RED}Hey, that was rhetorical.")
        msgbox("{COLOR GREEN}Point is, I've been investigating\naround here for some time now.")
        msgbox("{COLOR BLUE}Nobody here seems to notice, but\nthere's something weird goin' on.")
        msgbox("{COLOR RED}Weird objects, strange looking Pokemon,\ngrey trees and sandy grass.")
        applymovement(11,YanFaceLeft)
        msgbox("{COLOR RED}I've seen it! I swear!\n{COLOR BLUE}On Route 103, there's something strange.")
        applymovement(11,YanFaceRight)
        applymovement(11,YanFaceLeft)
        applymovement(11,YanFaceRight)
        applymovement(11,YanFaceLeft)
        applymovement(11,YanFacePlayer)
        msgbox("{COLOR RED}You can see for yourself!")
        msgbox("{COLOR GREEN}Anyway, if you see anything out\nof the ordinary, {COLOR RED}give me a call!")
        msgbox("{COLOR RED}See ya!")
        applymovement(11, YanMovement2)
        waitmovement(0)
        delay(50)
        applymovement(11, YanFaceDown)
        waitmovement(0)
        applymovement(11, YanWalkDown)
        waitmovement(0)
        msgbox("...")
        msgbox("{COLOR GREEN}Sorry, I almost forgot to\nask your name!")
        msgbox("{COLOR RED}...oh, {PLAYER}?")
        msgbox("{COLOR GREEN}Cool name, dude.")
        applymovement(11,YanFaceUp)
        waitmovement(0)
        waitmovement(0)
        fadeoutbgm(1)
        delay(100)
        msgbox("{PLAYER}...")
        delay(100)
        msgbox("You haven't...\p...seen a woman\nin grey, have you?")
        waitmessage
        multichoice(20, 5, MULTI_NONONO, FALSE)
        closemessage
        msgbox("{COLOR BLUE}...cool. Just curious.")
        msgbox("{COLOR GREEN}Be seeing ya.")
        applymovement(11,YanMovement3)
        waitmovement(0)
        fadeinbgm(1)
        removeobject(11)
        playbgm(MUS_OLDALE, FALSE)
        setflag(FLAG_FIRST_YAN_MEETING)
        delay(50)
        msgbox("You aren't going to call.")
        clearflag(FLAG_DISABLE_CATCHING)
        releaseall
    }
}

movement YanMovement1 {
    face_right
    walk_right * 6
    face_player
}

movement YanMovement2 {
    face_left
    walk_left * 2
}

movement YanMovement3 {
    face_left
    walk_left * 5
}


movement YanFaceDown {
    face_right
}

movement YanFaceLeft {
    face_up
}

movement YanFaceRight {
    face_down
}

movement YanWalkDown {
    walk_right
}

movement YanWalkUp {
    walk_left
}

text YanTextTest {
	"{COLOR RED}{SHADOW LIGHT_RED}Heyo! I'm talkin' to you!"
}

movement YanFaceUp {
    face_left
}

movement YanFacePlayer {
    face_player
}
