raw `SCHOOLROOF1_MapScripts::
	.byte 0
`

script SCHOOLROOF1_EventScript_Mystery {
	lockall
	msgbox("...it's beautiful.")
	msgbox("Please, just leave me alone.")
	msgbox("Why don't you explore down there?")
	releaseall
}

script SCHOOLROOF1_EventScript_NOTBEHIND {
	lockall
	clearflag(FLAG_CANPUSH)
	releaseall
}

script SCHOOLROOF1_EventScript_Behind {
	lockall
	setflag(FLAG_CANPUSH)
	releaseall
}

script SCHOOLROOF1_EventScript_DestroyGirl {
	removeobject(5)
	setflag(FLAG_BEACH_GIRL)
	releaseall
}

script SCHOOLROOF1_EventScript_Wallace {
	lockall
	applymovement(4, LookAtPlayer)
	msgbox("The storm gets worse and worse\nevery day.")
	msgbox("You should leave, before it swallows\nyou whole.")
	msgbox("Before the riptide pulls you too far,\nwhere your feet can't touch the sand,\pand you realize you can't breathe.")
	msgbox("But it'll be too late.")
	releaseall
}

script SCHOOLROOF1_EventScript_Boy {
	lockall
	msgbox("What a lovely day.")
	releaseall
}

script SCHOOLROOF1_EventScript_Tutorial {
	lockall
	applymovement(7, LookAtPlayer)
	msgbox("You've seen houses like this,\nI presume?")
	msgbox("Houses with no doors.")
	msgbox("Just windows, so you can see inside.")
	msgbox("But you want to enter?")
	msgbox("How nosy of you.")
	msgbox("Well, if you want to enter, you'll\nhave to ask the other person.")
	msgbox("The one staring through the window,\nright next to you.")
	releaseall
}

script SCHOOLROOF1_EventScript_Doorway {
	lockall
	msgbox("You sense someone breathing close to\nyou.")
	msgbox("You grasp their hand...")
	warp(MAP_WARPHOUSE1, 3, 7)
	waitstate
	releaseall
}

movement LookAtPlayer {
	face_player
}