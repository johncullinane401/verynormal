raw `SHADOWWORLD_HOUSE1_MapScripts::
	.byte 0
`

script SHADOWWORLD_HOUSE1_EventScript_Guy {
	lockall
	msgbox("It's been sooo long since I left\nmy house.")
	msgbox("I don't really want to go outside.")
	msgbox("giggles You can stay here as\nlong as you want!")
	releaseall
}

script SHADOWWORLD_HOUSE1_EventScript_Bookshelf {
	lockall
	msgbox("It's filled with all sorts of books.")
	msgbox("Read one?", MSGBOX_YESNO)
	if (var(VAR_RESULT) == YES) {
		msgbox("Nby nqi aclfm mjyhn ypyls xus\nniaynbyl. Nbys qiofx yun fohwb niaynbyl.\pNbys qiofx xlcpy bigy zlig\nwugjom niaynbyl. Cn myygyx um cz\phinbcha wiofx myjyluny nbyg.")
		msgbox("...what nonsense.")
	}
	releaseall
}
