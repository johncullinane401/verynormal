raw `WARPHOUSE1_MapScripts::
	.byte 0
`

script WARPHOUSE1_EventScript_Exit {
    lockall
    fadescreen(FADE_TO_BLACK)
    warp(MAP_FLOWERMOUNTAIN, 28, 36)
    waitstate
    fadescreen(FADE_FROM_BLACK)
    releaseall
}

script WARPHOUSE_EVENTSCRIPT_TV {
    lockall
    msgbox("Your favorite show is on.")
    msgbox("...oh, wait.")
    msgbox("No, it's just TV static.")
    releaseall
}