raw `WISTFULWILDERNESS1_MapScripts::
	.byte 0
`


script WISTFULWILDERNESS1_EventScipt_Sign {
    lockall
    msgbox("                                          ")
    releaseall
}

script WISTFULWILDERNESS1_EventScript_PokemonCenter {
    lockall
    random(25)
    if (var(VAR_RESULT) == 20 && flag(FLAG_ENTERED_PC) == TRUE) {
        warp(MAP_DARKCAVE1, 25,19)
        releaseall
        lockall
        waitstate
    } else {
        fadescreen(FADE_TO_BLACK)
        warp(MAP_WW_POKEMON_CENTER, 6, 8)
        setflag(FLAG_ENTERED_PC)
        waitstate
        fadescreen(FADE_FROM_BLACK)
    }
    releaseall
}

script WISTFULWILDERNESS1_EventScipt_Hole {
    lockall
    msgbox("There is a hole here.")
    msgbox("What will you do?")
    dynmultichoice(0,0, FALSE, 4, 0, DYN_MULTICHOICE_CB_NONE, "Investigate", "Jump Down", "Leave")
    switch (var(VAR_RESULT)) {
        case 0:
            msgbox("(You peer into the hole.)")
            msgbox("(The darkness runs very deep into\nthe earth...)")
            msgbox("(You can't discern how far down it\ngoes.)")
            break
        case 1:
            msgbox("(You step towards the hole.)")
            msgbox(".......")
            msgbox("(Are you sure you want to continue?)", MSGBOX_YESNO)
            if (var(VAR_RESULT) == YES) {
                msgbox("(You take another step into the abyss....!)")
                fadescreen(FADE_TO_BLACK)
                warp(MAP_PIT_LEVEL1, 2,10)
                waitstate
                msgbox(".")
                msgbox("..")
                msgbox("...")
                fadescreen(FADE_FROM_BLACK)
                msgbox("(....)")
                msgbox("You survived the fall.")
                msgbox("If this was a different game, your\nlegs would surely be shattered.")
                break
            } else {
                msgbox("(You step back from the pit.)")
                break
            }
        case 3:
            break
    }
    releaseall
}

script WISTFULWILDERNESS1_EventScipt_HoleSign {
    lockall
    msgbox("The deepest pit in the dream.")
    msgbox("Face the four sins and return when\nyou are ready.")
    releaseall
}
    