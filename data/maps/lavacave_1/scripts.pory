raw `lavacave_1_MapScripts::
	.byte 0
`

script lavacave_1_EventScript_WarpDevice {
    lockall
    msgbox("There is a strange contraption here.")
    msgbox("Press the button?", MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        warp(MAP_SNOWFOREST_END, 7, 11)
        waitstate
    }
    releaseall
}

script lavacave_1_EventScript_Boy {
    setflag(FLAG_TWIN_FIGHT)
    trainerbattle_double(TRAINER_JEFFREY_5, TWINSINTRO, TWINSOUTRO, TWINS_NOTENOUGH)
    removeobject(1)
    releaseall
}

text TWINSINTRO {
    "Qy'py ehiqh yuwbinbyl zil nyh syulm.\nIol vihx cm ohvlyueuvfy."
}

text TWINSOUTRO {
    ""
}

text TWINS_NOTENOUGH {
    "'Cmon."
}